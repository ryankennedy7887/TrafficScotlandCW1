<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="13dp">
    <ImageView android:id="@+id/kind_icon" android:layout_width="38dp" android:layout_height="38dp"
        android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="11dp" android:orientation="vertical">
        <TextView android:id="@+id/kind_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/comment" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="3" android:ellipsize="end"
            android:textSize="15sp" android:textColor="@color/ink"/>
    </LinearLayout>
</LinearLayout>
