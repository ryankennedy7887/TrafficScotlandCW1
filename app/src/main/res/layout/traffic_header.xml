<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/ink"
    android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingBottom="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/app_name" android:textStyle="bold" android:textSize="21sp" android:textColor="@color/white"/>
        <Button android:id="@+id/refresh" style="@style/Control" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Refresh" android:textColor="#BDFFF0"/>
        <Button android:id="@+id/credentials" style="@style/Control" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="API access" android:textColor="#BDFFF0"/>
    </LinearLayout>
    <TextView android:id="@+id/source_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Loading Traffic Scotland data…" android:textColor="#DAE9EC" android:textSize="12sp"
        android:accessibilityLiveRegion="polite"/>
</LinearLayout>
