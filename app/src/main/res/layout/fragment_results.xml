<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/result_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="5dp" android:paddingBottom="7dp"
        android:textColor="@color/muted" android:textSize="13sp" android:accessibilityLiveRegion="polite"/>
    <ListView android:id="@+id/result_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="#CFDEDF" android:dividerHeight="1dp"/>
</LinearLayout>
