<resources>
    <string name="app_name">Scotland Traffic</string>
    <color name="ink">#102D39</color>
    <color name="muted">#4B6470</color>
    <color name="teal">#116C64</color>
    <color name="paper">#F2F7F7</color>
    <color name="white">#FFFFFF</color>
    <style name="TrafficTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">#102D39</item>
        <item name="android:navigationBarColor">#102D39</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Control" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/teal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>
